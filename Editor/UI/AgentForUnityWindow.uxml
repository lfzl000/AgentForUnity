<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="window-root" class="afu-root">
        <ui:VisualElement class="afu-header">
            <ui:VisualElement class="afu-header__identity">
                <ui:Label text="Agent for Unity" class="afu-title" />
                <ui:VisualElement class="afu-connection">
                    <ui:VisualElement name="status-dot" class="afu-status-dot" />
                    <ui:Label name="connection-state" text="Not checked" class="afu-connection__label" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="afu-header__actions">
                <ui:Button name="reconnect-button" text="Reconnect" tooltip="Restart connection detection" />
                <ui:Button name="disconnect-button" text="Disconnect" tooltip="Stop the Codex App Server connection" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="afu-status-bar">
            <ui:Label name="status-text" text="Checking Codex..." class="afu-status-text" />
            <ui:Label name="project-summary" class="afu-project-summary" />
        </ui:VisualElement>

        <ui:VisualElement class="afu-workspace">
            <ui:VisualElement class="afu-conversations-pane">
                <ui:VisualElement class="afu-conversations-header">
                    <ui:Label text="Conversations" class="afu-conversations-title" />
                    <ui:VisualElement class="afu-conversations-actions">
                        <ui:Button name="new-thread-button" text="New Thread" tooltip="Start a new project-scoped thread" class="afu-conversations-new afu-primary-button" />
                        <ui:Button name="refresh-threads-button" text="↻" tooltip="Reload conversations for this Unity project" class="afu-conversations-refresh" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:ScrollView name="conversations-scroll" class="afu-conversations-scroll">
                    <ui:VisualElement name="conversations-list" class="afu-conversations-list" />
                </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement class="afu-chat-pane">
                <ui:VisualElement class="afu-thread-bar">
                    <ui:Label text="Thread" class="afu-field-caption" />
                    <ui:Label name="thread-value" text="Not started" class="afu-thread-value" />
                    <ui:Label name="turn-activity-indicator" class="afu-turn-activity" />
                    <ui:Label name="turn-state" text="Idle" class="afu-turn-state" />
                    <ui:Button name="request-compile-button" text="Compile Unity" tooltip="Request Unity script compilation for this completed conversation" class="afu-request-compile" />
                </ui:VisualElement>

                <ui:ScrollView name="messages-scroll" class="afu-messages">
                    <ui:VisualElement name="messages-list" class="afu-messages__list">
                        <ui:VisualElement name="messages-delivery-list" class="afu-messages__delivery-list" />
                    </ui:VisualElement>
                </ui:ScrollView>

                <ui:VisualElement name="chat-reasoning-panel" class="afu-chat-reasoning">
                    <ui:VisualElement class="afu-chat-reasoning__header">
                        <ui:Label name="chat-reasoning-title" text="Reasoning summary" class="afu-chat-reasoning__title" />
                    </ui:VisualElement>
                    <ui:Label name="chat-reasoning-body" class="afu-chat-reasoning__body" />
                </ui:VisualElement>

                <ui:VisualElement name="chat-approval-alert" class="afu-chat-approval-alert">
                    <ui:VisualElement class="afu-chat-approval-alert__text">
                        <ui:Label name="chat-approval-title" text="Permission required" class="afu-chat-approval-alert__title" />
                        <ui:Label name="chat-approval-message" text="Codex is waiting for your decision." class="afu-chat-approval-alert__message" />
                    </ui:VisualElement>
                    <ui:VisualElement name="chat-approval-actions" class="afu-chat-approval-alert__actions">
                        <ui:Button name="chat-allow-once-button" text="Allow Once" class="afu-chat-approval-action afu-chat-approval-action--allow" />
                        <ui:Button name="chat-allow-session-button" text="Allow Session" class="afu-chat-approval-action afu-chat-approval-action--allow" />
                        <ui:Button name="chat-decline-button" text="Decline" class="afu-chat-approval-action afu-chat-approval-action--decline" />
                        <ui:Button name="chat-cancel-turn-button" text="Cancel Turn" class="afu-chat-approval-action afu-chat-approval-action--cancel" />
                    </ui:VisualElement>
                    <ui:Button name="review-approval-button" text="Answer Request" class="afu-chat-approval-alert__button" />
                </ui:VisualElement>

                <ui:VisualElement class="afu-composer">
                    <ui:VisualElement class="afu-context-toolbar">
                        <ui:Button name="add-selection-button" text="+ Selection" />
                        <ui:Button name="add-console-button" text="+ Console" tooltip="Choose specific Console logs to attach" />
                        <ui:Button name="add-file-button" text="+ File" />
                        <ui:Button name="add-scene-button" text="+ Scene" />
                        <ui:Button name="add-git-diff-button" text="+ Git Diff" />
                        <ui:Button name="add-screenshot-button" text="+ Screenshot" tooltip="Attach an image from the clipboard (Cmd/Ctrl+V)" />
                    </ui:VisualElement>
                    <ui:VisualElement name="contexts-list" class="afu-contexts-list" />
                    <ui:TextField name="prompt-field" multiline="true" class="afu-prompt" />
                    <ui:VisualElement class="afu-composer__actions">
                        <ui:VisualElement class="afu-composer__settings">
                            <ui:DropdownField name="model-field" tooltip="Model" class="afu-select" />
                            <ui:DropdownField name="reasoning-field" tooltip="Reasoning effort" class="afu-select afu-select--reasoning" />
                            <ui:DropdownField name="permission-field" tooltip="Choose how Codex requests approval for file, command, and network access" class="afu-select afu-select--permission" />
                        </ui:VisualElement>
                        <ui:VisualElement class="afu-composer__commands">
                            <ui:Button name="interrupt-button" text="Stop" tooltip="Interrupt the active turn" />
                            <ui:Button name="send-button" text="Send" tooltip="Send this prompt to the current thread" class="afu-primary-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:ScrollView name="details-scroll" class="afu-details-pane">
                <ui:VisualElement name="approval-alert" class="afu-approval-alert">
                    <ui:Label name="approval-alert-title" text="ACTION REQUIRED" class="afu-approval-alert__title" />
                    <ui:Label name="approval-alert-message" text="Codex is waiting for permission before it can continue." class="afu-approval-alert__message" />
                </ui:VisualElement>
                <ui:Foldout name="approvals-foldout" text="Approvals" value="true" class="afu-foldout">
                    <ui:ScrollView name="approvals-list" class="afu-card-list afu-card-list--approvals" />
                </ui:Foldout>

                <ui:Foldout name="compile-foldout" text="Unity Compile" value="true" class="afu-foldout">
                    <ui:Label name="compile-summary" class="afu-detail-value" />
                    <ui:Label name="compile-details" class="afu-compile-details" />
                    <ui:Button name="continue-fix-button" text="Continue Fix" />
                </ui:Foldout>

                <ui:Foldout name="diff-foldout" text="Turn Diff" value="true" class="afu-foldout">
                    <ui:VisualElement name="diff-files-list" class="afu-diff-files" />
                    <ui:TextField name="diff-text" multiline="true" class="afu-diff-text" />
                </ui:Foldout>

                <ui:Foldout name="connection-foldout" text="Connection" value="true" class="afu-foldout">
                    <ui:VisualElement class="afu-detail-row">
                        <ui:Label text="CLI" class="afu-field-caption" />
                        <ui:Label name="cli-path-value" class="afu-detail-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="afu-detail-row">
                        <ui:Label text="Version" class="afu-field-caption" />
                        <ui:Label name="cli-version-value" class="afu-detail-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="afu-detail-row">
                        <ui:Label text="Account" class="afu-field-caption" />
                        <ui:Label name="account-value" class="afu-detail-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="afu-detail-row">
                        <ui:Label text="Project" class="afu-field-caption" />
                        <ui:Label name="project-value" class="afu-detail-value" />
                    </ui:VisualElement>
                </ui:Foldout>

                <ui:Foldout name="diagnostics-foldout" text="Diagnostics" value="true" class="afu-foldout afu-diagnostics-foldout">
                    <ui:ScrollView class="afu-diagnostics-scroll">
                        <ui:VisualElement name="diagnostics-list" class="afu-diagnostics-list" />
                    </ui:ScrollView>
                </ui:Foldout>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
