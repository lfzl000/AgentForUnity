.afu-root {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
}

.afu-header {
    min-height: 44px;
    padding: 7px 10px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.28);
}

.afu-header__identity,
.afu-header__actions,
.afu-connection,
.afu-composer__actions {
    flex-direction: row;
    align-items: center;
}

.afu-header__identity {
    min-width: 0;
    flex-shrink: 1;
}

.afu-header__metadata {
    min-width: 0;
    margin-left: 12px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.afu-header__metadata-item {
    min-width: 0;
    max-width: 250px;
    margin-right: 12px;
    flex-direction: row;
    align-items: center;
}

.afu-header__metadata-caption {
    margin-right: 4px;
    font-size: 10px;
    opacity: 0.58;
}

.afu-header__metadata-value {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 11px;
    opacity: 0.78;
}

.afu-title {
    font-size: 15px;
    -unity-font-style: bold;
    margin-right: 12px;
}

.afu-connection {
    padding: 3px 6px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.30);
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.06);
}

.afu-status-dot {
    width: 7px;
    height: 7px;
    margin-right: 5px;
    border-radius: 4px;
    background-color: rgb(142, 142, 147);
}

.afu-status-dot--ready {
    background-color: rgb(52, 168, 83);
}

.afu-status-dot--working {
    background-color: rgb(45, 132, 210);
}

.afu-status-dot--warning {
    background-color: rgb(218, 153, 38);
}

.afu-status-dot--error {
    background-color: rgb(207, 65, 65);
}

.afu-connection__label {
    font-size: 11px;
    -unity-font-style: bold;
}

.afu-header__actions > Button {
    margin-left: 5px;
}

.afu-header__actions > .afu-select--language {
    min-width: 82px;
    max-width: 96px;
    margin: 0 5px 0 0;
}

.afu-diagnostics-launcher {
    position: absolute;
    right: 8px;
    bottom: 8px;
    width: 24px;
    min-width: 24px;
    height: 24px;
    min-height: 24px;
    padding: 0;
    margin: 0;
    opacity: 0.42;
    color: rgba(210, 220, 230, 0.90);
    background-color: rgba(80, 90, 100, 0.18);
    border-color: rgba(128, 128, 128, 0.35);
    border-radius: 12px;
    -unity-font-style: bold;
}

.afu-diagnostics-launcher:hover {
    opacity: 0.90;
    background-color: rgba(45, 132, 210, 0.28);
}

.afu-primary-button {
    -unity-font-style: bold;
}

.afu-status-bar {
    min-height: 30px;
    padding: 5px 10px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(0, 0, 0, 0.07);
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.22);
}

.afu-root.afu--approval-required .afu-status-bar {
    background-color: rgba(218, 153, 38, 0.18);
    border-bottom-color: rgba(218, 153, 38, 0.85);
}

.afu-root.afu--approval-required .afu-status-text {
    -unity-font-style: bold;
}

.afu-status-text {
    flex-grow: 1;
    white-space: normal;
}

.afu-project-summary {
    max-width: 45%;
    margin-left: 12px;
    opacity: 0.65;
    -unity-text-align: middle-right;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.afu-workspace {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    flex-direction: row;
}

.afu-conversations-pane {
    width: 220px;
    min-width: 180px;
    min-height: 0;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: rgba(128, 128, 128, 0.25);
    background-color: rgba(0, 0, 0, 0.025);
}

.afu-conversations-header {
    min-height: 64px;
    padding: 6px 7px 6px 10px;
    flex-direction: column;
    align-items: stretch;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.20);
}

.afu-conversations-title {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.afu-conversations-actions {
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.afu-conversations-new {
    flex-grow: 1;
    min-height: 24px;
    margin-right: 4px;
    font-size: 11px;
}

.afu-conversations-refresh {
    width: 26px;
    min-width: 26px;
    height: 24px;
    min-height: 24px;
    padding-left: 0;
    padding-right: 0;
    font-size: 15px;
    -unity-text-align: middle-center;
}

.afu-conversations-scroll {
    flex-grow: 1;
    min-height: 0;
}

.afu-account-summary {
    flex-shrink: 0;
    max-height: 180px;
    padding: 8px 10px 10px 10px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.25);
    background-color: rgba(0, 0, 0, 0.045);
}

.afu-account-summary__caption {
    margin-top: 9px;
    padding-top: 7px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.22);
    font-size: 10px;
    opacity: 0.58;
    -unity-font-style: bold;
}

.afu-account-summary__value {
    min-width: 0;
    margin-top: 1px;
    white-space: normal;
    font-size: 12px;
    opacity: 0.85;
}

.afu-conversations-list {
    padding: 6px;
}

.afu-conversation {
    min-height: 54px;
    margin-bottom: 4px;
    padding: 7px 8px;
    align-items: stretch;
    background-color: rgba(0, 0, 0, 0.04);
    border-left-width: 3px;
    border-left-color: rgba(128, 128, 128, 0.28);
    border-radius: 4px;
}

.afu-conversation:hover {
    background-color: rgba(45, 132, 210, 0.10);
}

.afu-conversation--selected {
    border-left-color: rgb(45, 132, 210);
    background-color: rgba(45, 132, 210, 0.15);
}

.afu-conversation__title {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    font-size: 11px;
}

.afu-conversation__title-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.afu-conversation__activity {
    width: 12px;
    min-width: 12px;
    margin-left: 5px;
    color: rgb(45, 132, 210);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.afu-conversation__meta {
    margin-top: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
    font-size: 9px;
    opacity: 0.58;
}

.afu-conversations-empty {
    margin: 16px 8px;
    white-space: normal;
    -unity-text-align: middle-center;
    opacity: 0.55;
}

.afu-conversations-load-more {
    width: 100%;
    min-height: 24px;
    margin-top: 6px;
    font-size: 11px;
}

.afu-chat-pane {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 280px;
}

.afu-select {
    width: 120px;
    min-width: 120px;
    max-width: 120px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 5px;
    margin-bottom: 3px;
}

.afu-select--reasoning {
    width: 60px;
    min-width: 60px;
    max-width: 60px;
}

.afu-select--permission {
    width: 105px;
    min-width: 105px;
    max-width: 105px;
}

.afu-turn-state {
    min-width: 74px;
    margin-left: 8px;
    padding: 3px 6px;
    border-radius: 4px;
    background-color: rgba(128, 128, 128, 0.13);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.afu-turn-activity {
    width: 12px;
    margin-left: 8px;
    color: rgb(45, 132, 210);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.afu-request-compile {
    min-height: 22px;
    margin-left: 6px;
    font-size: 10px;
}

.afu-thread-bar {
    min-height: 28px;
    padding: 4px 10px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.035);
}

.afu-field-caption {
    min-width: 58px;
    opacity: 0.62;
    font-size: 11px;
    -unity-font-style: bold;
}

.afu-thread-value {
    min-width: 0;
    flex-grow: 1;
    margin-left: 4px;
    opacity: 0.78;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.afu-messages {
    flex-grow: 1;
    flex-shrink: 1;
    height: 0;
    min-height: 100px;
}

.afu-messages .unity-scroll-view__content-viewport,
.afu-messages .unity-scroll-view__content-container {
    min-width: 0;
    max-width: 100%;
}

.afu-messages__list {
    min-width: 0;
    width: 100%;
    max-width: 100%;
    padding: 10px;
}

.afu-turn-process {
    margin-bottom: 8px;
    padding: 6px 8px;
    border-width: 1px;
    border-color: rgba(204, 137, 38, 0.30);
    border-left-width: 3px;
    border-left-color: rgb(204, 137, 38);
    border-radius: 4px;
    background-color: rgba(204, 137, 38, 0.055);
    font-size: 10px;
}

.afu-turn-process .afu-message--agent,
.afu-message.afu-message--process {
    border-left-color: rgb(204, 137, 38);
}

.afu-empty-state {
    margin-top: 24px;
    opacity: 0.58;
    -unity-text-align: middle-center;
}

.afu-message {
    min-width: 0;
    width: 100%;
    max-width: 100%;
    margin-bottom: 8px;
    padding: 8px 10px;
    border-left-width: 3px;
    border-left-color: rgba(128, 128, 128, 0.45);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.18);
    border-right-color: rgba(128, 128, 128, 0.18);
    border-bottom-color: rgba(128, 128, 128, 0.18);
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.045);
}

.afu-message--user {
    border-left-color: rgb(45, 132, 210);
}

.afu-message--agent {
    border-left-color: rgb(52, 168, 83);
}

.afu-message__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.afu-message__role {
    font-size: 11px;
    -unity-font-style: bold;
}

.afu-message__streaming {
    margin-left: 7px;
    font-size: 10px;
    opacity: 0.62;
}

.afu-message__copy {
    min-width: 22px;
    width: 22px;
    height: 20px;
    min-height: 20px;
    margin-left: auto;
    padding: 0;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.afu-message__body {
    min-width: 0;
    width: 100%;
    max-width: 100%;
    flex-shrink: 1;
    white-space: normal;
}

.afu-message-activity {
    display: none;
    margin-top: 8px;
    padding-top: 5px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.18);
    font-size: 10px;
}

.afu-message-activity__list {
    margin-top: 4px;
}

.afu-message-activity .unity-foldout__text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.afu-message-activity__detail {
    margin: 2px 0 5px 0;
    padding: 5px 6px;
    border-left-width: 2px;
    border-left-color: rgba(128, 128, 128, 0.48);
    background-color: rgba(0, 0, 0, 0.04);
}

.afu-message-activity__status {
    margin-bottom: 4px;
    font-size: 9px;
    opacity: 0.58;
}

.afu-markdown__paragraph,
.afu-markdown__list,
.afu-markdown__quote,
.afu-markdown__code-block,
.afu-markdown__heading {
    min-width: 0;
    width: 100%;
    max-width: 100%;
    margin-bottom: 7px;
}

.afu-markdown__heading {
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
    white-space: normal;
    -unity-font-style: bold;
}

.afu-markdown__heading--h1 {
    margin-top: 4px;
    font-size: 16px;
}

.afu-markdown__heading--h2 {
    margin-top: 3px;
    font-size: 14px;
}

.afu-markdown__heading--h3 {
    margin-top: 2px;
    font-size: 12px;
}

.afu-markdown__list-item {
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
    flex-direction: row;
    margin-bottom: 3px;
}

.afu-markdown__list-marker {
    min-width: 22px;
    opacity: 0.72;
    -unity-text-align: upper-right;
}

.afu-markdown__list-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
}

.afu-markdown__link {
    min-width: 0;
    max-width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    color: rgb(90, 169, 230);
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
    white-space: normal;
}

.afu-markdown__link:hover {
    color: rgb(133, 196, 245);
    background-color: rgba(90, 169, 230, 0.10);
}

.afu-markdown__inline {
    flex-direction: column;
}

.afu-markdown__inline-line {
    min-width: 0;
    max-width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.afu-markdown__inline-text {
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
    white-space: normal;
}

.afu-markdown__inline-link {
    width: auto;
    min-width: 0;
    min-height: 0;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0 1px;
    padding: 0;
    border-width: 0;
    border-radius: 0;
}

.afu-markdown__quote {
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    padding: 4px 8px;
    border-left-width: 3px;
    border-left-color: rgba(90, 169, 230, 0.75);
    background-color: rgba(90, 169, 230, 0.08);
}

.afu-markdown__quote-text {
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
    white-space: normal;
    opacity: 0.82;
}

.afu-markdown__code-block {
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    padding: 6px 8px;
    background-color: rgba(0, 0, 0, 0.16);
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.26);
    border-radius: 3px;
}

.afu-markdown__code-language {
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
    margin-bottom: 4px;
    white-space: normal;
    font-size: 9px;
    opacity: 0.58;
    -unity-font-style: bold;
}

.afu-markdown__code {
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
    white-space: normal;
    font-size: 11px;
}

.afu-markdown__rule {
    height: 1px;
    margin: 8px 0;
    background-color: rgba(128, 128, 128, 0.35);
}

.afu-message__attachments {
    display: none;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 5px;
}

.afu-message__attachments-caption {
    margin-right: 5px;
    font-size: 10px;
    opacity: 0.62;
}

.afu-message__attachment {
    margin: 0 4px 3px 0;
    padding: 2px 6px;
    border-width: 1px;
    border-color: rgba(45, 132, 210, 0.55);
    border-radius: 8px;
    background-color: rgba(45, 132, 210, 0.14);
    font-size: 10px;
}

.afu-chat-approval-alert {
    display: none;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin: 8px 10px 6px 10px;
    padding: 9px 10px;
    border-width: 1px;
    border-left-width: 5px;
    border-color: rgba(218, 153, 38, 0.95);
    border-radius: 4px;
    background-color: rgba(218, 153, 38, 0.16);
}

.afu-chat-approval-alert__text {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.afu-chat-approval-alert__title {
    color: rgb(235, 171, 54);
    font-size: 13px;
    -unity-font-style: bold;
}

.afu-chat-approval-alert__message {
    margin-top: 2px;
    white-space: normal;
    font-size: 11px;
}

.afu-chat-approval-alert__button {
    display: none;
    flex-shrink: 0;
    min-width: 124px;
    margin-left: 12px;
    -unity-font-style: bold;
    background-color: rgba(218, 153, 38, 0.28);
}

.afu-chat-approval-alert__actions {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    max-width: 470px;
    margin-left: 12px;
}

.afu-chat-approval-action {
    min-width: 92px;
    margin: 2px 0 2px 5px;
}

.afu-chat-approval-action--allow {
    -unity-font-style: bold;
    background-color: rgba(52, 168, 83, 0.30);
}

.afu-chat-approval-action--decline {
    background-color: rgba(207, 65, 65, 0.22);
}

.afu-chat-approval-action--cancel {
    background-color: rgba(128, 128, 128, 0.22);
}

.afu-composer {
    flex-shrink: 0;
    padding: 8px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.25);
}

.afu-context-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.afu-context-toolbar > Button {
    margin-right: 4px;
    margin-bottom: 3px;
    font-size: 10px;
}

.afu-contexts-list {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 3px;
}

.afu-context-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 4px;
    margin-bottom: 3px;
    padding: 2px 4px 2px 6px;
    border-radius: 8px;
    background-color: rgba(45, 132, 210, 0.16);
}

.afu-context-chip__label {
    font-size: 10px;
}

.afu-context-chip__remove {
    width: 18px;
    height: 17px;
    margin-left: 3px;
    padding: 0;
    font-size: 10px;
}

.afu-screenshot-preview {
    position: relative;
    width: 96px;
    height: 72px;
    flex-shrink: 0;
    margin-right: 6px;
    margin-bottom: 5px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.48);
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.14);
}

.afu-screenshot-preview__image {
    width: 94px;
    height: 70px;
}

.afu-screenshot-preview__unavailable {
    width: 94px;
    height: 70px;
    padding: 5px;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 9px;
    opacity: 0.65;
}

.afu-screenshot-preview__remove {
    position: absolute;
    right: 3px;
    top: 3px;
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    padding: 0;
    margin: 0;
    border-radius: 3px;
    background-color: rgba(20, 20, 20, 0.82);
    color: rgb(245, 245, 245);
    -unity-font-style: bold;
}

.afu-prompt {
    min-height: 70px;
    max-height: 180px;
    margin-bottom: 6px;
}

.afu-prompt .unity-text-field__input {
    white-space: normal;
}

.afu-composer__actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: flex-start;
}

.afu-composer__settings {
    min-width: 0;
    flex-grow: 0;
    flex-shrink: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
}

.afu-composer__commands {
    flex-shrink: 0;
    flex-direction: row;
    margin-left: auto;
}

.afu-context-usage {
    display: none;
    min-width: 38px;
    margin: 0 3px 1px 0;
    padding: 2px 6px;
    white-space: nowrap;
    font-size: 10px;
    opacity: 0.75;
    -unity-text-align: middle-right;
}

.afu-composer__commands > Button {
    min-width: 64px;
    margin-left: 5px;
}

.afu-details-pane {
    width: 280px;
    min-width: 230px;
    min-height: 0;
    padding: 5px 8px 8px 8px;
    border-left-width: 1px;
    border-left-color: rgba(128, 128, 128, 0.25);
    background-color: rgba(0, 0, 0, 0.035);
}

.afu-approval-alert {
    display: none;
    margin: 3px 0 8px 0;
    padding: 8px 9px;
    border-width: 1px;
    border-left-width: 5px;
    border-color: rgba(218, 153, 38, 0.95);
    border-radius: 4px;
    background-color: rgba(218, 153, 38, 0.16);
}

.afu-approval-alert__title {
    color: rgb(235, 171, 54);
    font-size: 13px;
    -unity-font-style: bold;
}

.afu-approval-alert__message {
    margin-top: 3px;
    white-space: normal;
    font-size: 10px;
}

.afu-card-list {
    min-height: 0;
    max-height: 250px;
    overflow: hidden;
}

.afu-card-list--approvals {
    max-height: 340px;
}

.afu-card,
.afu-approval-card {
    margin: 2px 0 6px 0;
    padding: 6px;
    border-left-width: 2px;
    border-left-color: rgba(45, 132, 210, 0.85);
    background-color: rgba(0, 0, 0, 0.055);
}

.afu-approval-card {
    border-left-color: rgba(218, 153, 38, 0.9);
}

.afu-approval-card--pending {
    padding: 8px;
    border-width: 1px;
    border-left-width: 4px;
    border-color: rgba(218, 153, 38, 0.95);
    background-color: rgba(218, 153, 38, 0.13);
}

.afu-approval-card--resolved {
    opacity: 0.62;
}

.afu-card__title {
    -unity-font-style: bold;
    font-size: 11px;
    margin-bottom: 2px;
}

.afu-card__body,
.afu-compile-details {
    white-space: normal;
    font-size: 10px;
}

.afu-compile-details-scroll {
    max-height: 180px;
    min-height: 0;
    margin: 4px 0;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.25);
    background-color: rgba(0, 0, 0, 0.045);
}

.afu-compile-details-scroll .unity-scroll-view__content-container {
    min-width: 0;
    padding: 4px 6px;
}

.afu-card__actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 5px;
}

.afu-card__actions > Button {
    margin-right: 3px;
    margin-bottom: 3px;
}

.afu-card__actions > .afu-approval-button--allow {
    -unity-font-style: bold;
    background-color: rgba(52, 168, 83, 0.30);
}

.afu-card__actions > .afu-approval-button--decline {
    background-color: rgba(207, 65, 65, 0.22);
}

.afu-question {
    margin-top: 5px;
}

.afu-question__label {
    white-space: normal;
    font-size: 10px;
    margin-bottom: 2px;
}

.afu-diff-files {
    flex-direction: column;
    margin-bottom: 4px;
}

.afu-project-changes-summary {
    margin: 1px 4px 4px 4px;
    white-space: normal;
    font-size: 10px;
    color: rgb(190, 190, 190);
}

.afu-project-change {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    min-height: 21px;
    margin-bottom: 1px;
    padding: 1px 4px;
}

.afu-project-change__name {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
    font-size: 10px;
}

.afu-project-change__status {
    width: 14px;
    flex-shrink: 0;
    margin-left: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 11px;
}

.afu-project-change__status--modified {
    color: rgb(78, 201, 176);
}

.afu-project-change__status--added {
    color: rgb(181, 206, 168);
}

.afu-project-change__status--deleted {
    color: rgb(244, 135, 113);
}

.afu-project-change__status--renamed {
    color: rgb(220, 220, 170);
}

.afu-foldout {
    margin-bottom: 5px;
}

.afu-detail-row {
    flex-direction: row;
    align-items: flex-start;
    padding: 3px 2px;
}

.afu-detail-row > .afu-field-caption {
    width: 58px;
    flex-shrink: 0;
    margin-right: 6px;
    padding-top: 1px;
}

.afu-detail-value {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    overflow: visible;
}

.afu-diagnostic {
    margin: 2px 0 5px 0;
    padding: 5px 6px;
    white-space: normal;
    border-left-width: 2px;
    border-left-color: rgba(218, 153, 38, 0.85);
    background-color: rgba(0, 0, 0, 0.055);
}

.afu-diagnostic--empty {
    opacity: 0.55;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.afu-root.afu--compact .afu-header {
    align-items: stretch;
    flex-direction: column;
}

.afu-root.afu--compact .afu-header__actions {
    margin-top: 6px;
    justify-content: flex-end;
}

.afu-root.afu--compact .afu-header__metadata {
    width: 100%;
    margin-top: 4px;
    margin-left: 0;
}

.afu-root.afu--compact .afu-header__metadata-item {
    max-width: none;
    flex-grow: 1;
}

.afu-root.afu--compact .afu-status-bar {
    align-items: stretch;
    flex-direction: column;
}

.afu-root.afu--compact .afu-project-summary {
    max-width: none;
    margin-top: 2px;
    margin-left: 0;
    -unity-text-align: middle-left;
}

.afu-root.afu--compact .afu-workspace {
    flex-direction: column;
}

.afu-root.afu--compact .afu-conversations-pane {
    width: auto;
    min-width: 0;
    height: 164px;
    min-height: 120px;
    flex-shrink: 0;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.25);
}

.afu-root.afu--compact .afu-account-summary {
    max-height: 116px;
}

.afu-root.afu--compact .afu-select {
    width: auto;
    min-width: 120px;
    max-width: none;
    flex-grow: 1;
    margin-right: 0;
    margin-bottom: 3px;
}

.afu-root.afu--compact .afu-select--permission {
    min-width: 150px;
}

.afu-root.afu--compact .afu-composer__settings {
    width: 100%;
}

.afu-root.afu--compact .afu-composer__commands {
    margin-top: 2px;
}

.afu-root.afu--compact .afu-chat-approval-alert {
    align-items: stretch;
    flex-direction: column;
}

.afu-root.afu--compact .afu-chat-approval-alert__button {
    margin-top: 7px;
    margin-left: 0;
}

.afu-root.afu--compact .afu-chat-approval-alert__actions {
    justify-content: flex-start;
    max-width: none;
    margin-top: 7px;
    margin-left: 0;
}

.afu-root.afu--compact .afu-chat-approval-action {
    margin-left: 0;
    margin-right: 5px;
}

.afu-root.afu--compact .afu-details-pane {
    width: auto;
    min-width: 0;
    max-height: 300px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.25);
    border-left-width: 0;
}

.afu-root.afu--compact .afu-connection__label {
    white-space: normal;
}
